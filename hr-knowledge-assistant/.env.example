# ---------- LLM ----------
# One of: auto | groq | openai | azure_openai | gemini | ollama | mock
# "auto" picks the first provider whose API key is set, else falls back to "mock"
# (an offline, extractive answerer so the app runs with no key at all).
LLM_PROVIDER=auto
LLM_MODEL=                      # optional override, e.g. llama-3.3-70b-versatile / gpt-4o-mini / gemini-2.0-flash
LLM_TEMPERATURE=0.1

GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings ----------
# fastembed = local ONNX model (BAAI/bge-small-en-v1.5), free, no key
# openai    = text-embedding-3-small
# hash      = offline hashing vectoriser (tests / air-gapped demo)
EMBEDDING_PROVIDER=fastembed

# ---------- Retrieval ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
RELEVANCE_THRESHOLD=0.45
LLM_GRADER=true              # second-stage "can the context answer this?" check

# ---------- Storage ----------
DOCS_DIR=data/policies
CHROMA_DIR=storage/chroma
DATABASE_URL=sqlite:///storage/hr.db
